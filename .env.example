# AI Market Intelligence & Paper Trading Platform - Configuration
PROJECT_NAME="AI Market Intelligence & Paper Trading Platform"
API_V1_STR="/api/v1"

# Database Configuration (Defaults to local SQLite async; can be pointed to PostgreSQL/TimescaleDB)
DATABASE_URL="sqlite+aiosqlite:///./market_intelligence.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/market_intelligence"

# Google Gemini Flash API Key (For qualitative market reasoning & explanations)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Quantitative Risk & Evaluation Defaults
DEFAULT_NEUTRAL_THRESHOLD_PCT=0.15
DEFAULT_SLIPPAGE_BPS=2.0
DEFAULT_FEE_BPS=3.0
DEFAULT_PAPER_CASH=1000000.0
